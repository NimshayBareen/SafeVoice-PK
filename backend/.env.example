# Copy this file to ".env" and fill in the values.   (Windows: copy .env.example .env)

PORT=5000
# Format: postgres://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgres://postgres:postgres@localhost:5432/safevoice
# Set to true for hosted databases that require SSL (Neon, Render, Supabase)
DATABASE_SSL=false

# Two secrets. Generate each with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
# Wraps the per-case encryption keys. 64 hex characters, or any passphrase of 24+ characters.
# KEEP A COPY: if it is lost, stored evidence can no longer be decrypted.
MASTER_KEY=

# ---- E-mail (verification codes) ----------------------------------------------------------
# Gmail example (needs 2-step verification and an "App password", see README):
#   SMTP_HOST=smtp.gmail.com   SMTP_PORT=465   SMTP_SECURE=true
#   SMTP_USER=yourname@gmail.com   SMTP_PASS=<16-letter app password>
#   SMTP_FROM="SV Account <yourname@gmail.com>"
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# Demo only: if no SMTP is set, show the 6-digit code on screen. MUST be false on a real deployment.
DEV_SHOW_OTP=true
OTP_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_SECONDS=60

# ---- Storage -------------------------------------------------------------------------------
# disk = files in STORAGE_DIR.   db = encrypted files inside PostgreSQL (use this on Render and similar hosts)
STORAGE_DRIVER=disk
STORAGE_DIR=./storage
MAX_FILE_MB=25

# ---- Sessions and sign-in rules ------------------------------------------------------------
MAX_FAILED_LOGINS=5
LOCK_MINUTES=15
SESSION_MINUTES=30

# ---- AI assistant (optional) ---------------------------------------------------------------
# Without a key, the assistant answers with extracts from the legal knowledge base.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5

# ---- First administrator (created by `npm run migrate` if it does not exist) -----------------
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ---- Web address of the app ----------------------------------------------------------------
APP_URL=http://localhost:5173
# Set to true when the app runs behind a proxy such as Render or Nginx
TRUST_PROXY=false
